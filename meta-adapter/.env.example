# Server Configuration
PORT=8080
HOST=0.0.0.0

# Environment
ENVIRONMENT=development

# API Configuration
API_VERSION=v1
API_BASE_PATH=/api/v1

# WhatsApp Configuration
WHATSAPP_STORE_PATH=./data/sessions
WHATSAPP_AUTO_RECONNECT=true

# Webhook Configuration
WEBHOOK_URL=http://localhost:3000/webhook
WEBHOOK_VERIFY_TOKEN=your_verify_token_here
WEBHOOK_TIMEOUT=30s
WEBHOOK_RETRY_ATTEMPTS=3

# Security
API_KEY=your_api_key_here
# Comma-separated list of allowed API keys for multi-tenant
API_KEYS=key1,key2,key3

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_BURST=10

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Database
DB_PATH=./data/adapter.db

# CORS
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*

# Media
MEDIA_MAX_SIZE_MB=16
MEDIA_TEMP_DIR=./data/temp

# Session Management
SESSION_TIMEOUT=24h
SESSION_CLEANUP_INTERVAL=1h
