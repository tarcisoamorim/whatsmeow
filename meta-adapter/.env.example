# Server Configuration
HOST=0.0.0.0
PORT=8080

# Database Configuration
DATABASE_URL=postgresql://whatsapp:password@localhost:5432/whatsapp_adapter?sslmode=disable
POSTGRES_PASSWORD=whatsapp_secure_password_change_me

# Redis Configuration
REDIS_URL=redis://default:password@localhost:6379/0
REDIS_PASSWORD=redis_secure_password_change_me

# RabbitMQ Configuration
RABBITMQ_URL=amqp://whatsapp:password@localhost:5672/whatsapp_adapter
RABBITMQ_USER=whatsapp
RABBITMQ_PASSWORD=rabbitmq_secure_password_change_me

# JWT Configuration
JWT_SECRET=change_me_in_production_this_should_be_very_long_and_random_at_least_32_characters

# Webhook Configuration
WEBHOOK_SECRET=change_me_in_production_webhook_secret_32_chars_min
WEBHOOK_RETRY_MAX=5
WEBHOOK_TIMEOUT_SECONDS=30

# WhatsApp Configuration
INSTANCE_SESSION_TIMEOUT=3600
WHATSAPP_QR_CODE_TIMEOUT=120

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Optional: S3 for media storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=whatsapp-media
